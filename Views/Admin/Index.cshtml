@model IEnumerable<PizzeriaNicDen.Models.Pizza>

@{
    ViewData["Title"] = "Panou Administrare";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a class="btn btn-accent fw-bold rounded-pill px-4" asp-controller="Admin" asp-action="Anunturi">Anunțuri pe site</a>
        <h2 class="section-title mb-0">Gestionare Meniu</h2>
        
        <a asp-action="AdaugaPizza" class="btn btn-accent">Adaugă Pizza Nouă</a>
    </div>

    <div class="table-responsive rounded shadow-sm">
        <table class="table table-dark table-hover align-middle mb-0" style="border-color: #3d3d3d;">
            <thead style="border-bottom: 2px solid var(--accent-gold);">
                <tr>
                    <th>Imagine</th>
                    <th>Nume</th>
                    <th>Preț 30cm</th>
                    <th>Preț 50cm</th>
                    <th>Acțiuni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.CaleImagine" alt="@item.Nume" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                        </td>
                        <td class="fw-bold" style="color: var(--accent-gold);">@item.Nume</td>
                        <td>@item.Pret30cm.ToString("0.00") lei</td>
                        <td>
                            @(item.VariantaFamily != null ? item.VariantaFamily.Pret50cm.ToString("0.00") + " lei" : "-")
                        </td>
                        <td>
                            <a asp-action="EditeazaPizza" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editează</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>