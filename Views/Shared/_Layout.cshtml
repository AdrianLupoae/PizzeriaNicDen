<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PizzeriaNicDen</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PizzeriaNicDen.styles.css" asp-append-version="true" />
</head>
<body>
<header>
 
    <nav class="navbar navbar-expand-lg navbar-dark mb-3" style="padding: 0.4rem 1rem;">
        <div class="container-fluid align-items-center">

            <!-- Etichetă vizibilă doar pe telefon, lângă butonul hamburger -->
            <span class="d-lg-none fw-bold" style="color: var(--accent-gold); letter-spacing: 1px;">MENIU</span>

            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon" style="filter: invert(1) sepia(1) saturate(5) hue-rotate(10deg);"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-between align-items-center" id="navbarContent">
                <ul class="navbar-nav align-items-lg-center gap-lg-2 mb-2 mb-lg-0">

                    <!-- Link-uri pagini interne -->
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Acasă</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Recenzii" asp-action="Index">Recenzii</a>
                    </li>

                    <!-- Buton Locație -->
                    <li class="nav-item ms-lg-2">
                        <!-- Înlocuiește cu linkul exact din Google Maps (Share -> Copy link) -->
                        <a class="btn-nav" href="https://www.google.com/maps/search/?api=1&query=Pizzeria+Nic+si+Den" target="_blank" rel="noopener">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
                            Locație
                        </a>
                    </li>

                    <!-- Buton Facebook -->
                    <li class="nav-item">
                        <a class="btn-nav" href="https://www.facebook.com/PizzeriaNicsiDen/?locale=ro_RO" target="_blank" rel="noopener">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
                            Facebook
                        </a>
                    </li>


                                        <!-- Buton Evenimente (deschide fereastra) -->
                    <li class="nav-item">
                        <a class="btn-nav" href="#" role="button" data-bs-toggle="modal" data-bs-target="#eventModal">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm12 8v10H5V10h14z"/></svg>
                            Evenimente
                        </a>
                    </li>



                    <!-- Link Admin (vizibil doar pentru Owner) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item ms-lg-2">
                            <a class="btn-nav btn-nav-admin" asp-area="" asp-controller="Admin" asp-action="Index">Panou Admin</a>
                        </li>
                    }


                </ul>

                <!-- Secțiunea Autentificare (Dreapta) -->
                <ul class="navbar-nav align-items-center nav-auth">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center">
                            <span class="me-3 user-greeting">Salut, @User.Identity.Name!</span>
                            <a class="btn-nav btn-nav-logout" asp-area="" asp-controller="Account" asp-action="Logout">Deconectare</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-accent btn-sm fw-bold px-3 py-2 rounded-pill" asp-area="" asp-controller="Account" asp-action="Login">Conectare cu Google</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
       <!-- Logo-ul firmei, centrat -->
    <div class="logo-banner">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo.png" alt="Logo Pizzeria Nic&Den" class="brand-logo" />
        </a>
    </div>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

<footer class="site-footer mt-5">
    <div class="container py-4">
        <div class="row g-4">

            <!-- Date operator -->
            <div class="col-md-4">
                <h6>Pizzeria Nic&Den</h6>
                <p class="mb-1">NIC & DEN FOOD SRL</p>
                <p class="mb-1">RO37307331</p>
                <p class="mb-1">Strada Anghel Saligny 122 807180 Liești</p>
                <p class="mb-1">Comenzi: <a href="tel:0759108991">0759 108 991</a></p>
             <!--   <p class="mb-0">E-mail: <a href="mailto:[EMAIL]">[EMAIL]</a></p> -->
            </div>

            <!-- Informații -->
            <div class="col-md-4">
                <h6>Informații</h6>
                <ul class="list-unstyled mb-0">
                    <li><a asp-controller="Home" asp-action="Termeni">Termeni și condiții</a></li>
                    <li><a asp-controller="Home" asp-action="Confidentialitate">Politica de confidențialitate</a></li>
                    <li><a asp-controller="Home" asp-action="Cookies">Politica de cookie-uri</a></li>
                    <li><a asp-controller="Home" asp-action="Alergeni">Informații despre alergeni</a></li>
                </ul>
            </div>

            <!-- Protecția consumatorilor -->
            <div class="col-md-4">
                <h6>Protecția consumatorilor</h6>
                <ul class="list-unstyled mb-0">
                    <li><a href="https://anpc.ro/" target="_blank" rel="noopener">ANPC - Autoritatea Națională pentru Protecția Consumatorilor</a></li>
                    <li><a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener">SAL - Soluționarea Alternativă a Litigiilor</a></li>
                </ul>
            </div>
        </div>

        <div class="text-center small mt-4 pt-3 footer-bottom">
            &copy; @DateTime.Now.Year Pizzeria Nic&Den. Toate drepturile rezervate.
        </div>
    </div>
</footer>



    <!-- Fereastra Evenimente -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content event-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">Organizăm evenimentul tău</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Închide"></button>
                </div>
                <div class="modal-body">
                    <p>
                        La Pizzeria Nic&amp;Den poți organiza evenimente private:
                        aniversări, petreceri între prieteni, mese de familie sau întâlniri de firmă.
                    </p>
                    <p>
                        Meniul, data, numărul de persoane și celelalte detalii se stabilesc împreună,
                        în funcție de nevoile tale. Sună-ne și discutăm direct.
                    </p>
                    <p class="event-phone mb-0">
                        Telefon: <a href="tel:0759108991">0759 108 991</a>
                    </p>
                </div>
                <div class="modal-footer">
                    <a href="tel:0759108991" class="btn btn-accent fw-bold rounded-pill px-4">Sună acum</a>
                    <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Închide</button>
                </div>
            </div>
        </div>
    </div>


    @await Component.InvokeAsync("AnuntActiv")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
