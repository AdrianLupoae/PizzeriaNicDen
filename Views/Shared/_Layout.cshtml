<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PizzeriaNicDen</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PizzeriaNicDen.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark mb-3" style="background-color: var(--bg-dark); border-bottom: 1px solid var(--accent-gold); padding: 0.5rem 1rem;">
        <div class="container-fluid align-items-center">
            
            <!-- Logo-ul firmei -->
            <a class="navbar-brand py-0" asp-area="" asp-controller="Home" asp-action="Index">
                <!-- Modifică extensia .png în .jpg dacă acesta este formatul real al pozei din wwwroot/img -->
                <img src="~/img/logo.jpg" alt="Logo Nic&Den" style="height: 45px; object-fit: contain;" />
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon" style="filter: invert(1) sepia(1) saturate(5) hue-rotate(10deg);"></span>
            </button>
            
            <div class="collapse navbar-collapse justify-content-between align-items-center" id="navbarContent">
                <ul class="navbar-nav align-items-lg-center gap-2 mb-2 mb-lg-0">
                    
                    <!-- Link-uri pagini interne -->
                    <li class="nav-item">
                        <a class="nav-link text-light px-2" asp-area="" asp-controller="Home" asp-action="Index">Acasă</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light px-2" asp-area="" asp-controller="Recenzii" asp-action="Index">Recenzii</a>
                    </li>
                    
                    <!-- Buton Locație stilizat -->
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-1 fw-bold" href="" target="_blank">
                            📍 Locație
                        </a>
                    </li>
                    
                    <!-- Buton Facebook stilizat -->
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 px-3 py-1 fw-bold" href="https://www.facebook.com/PizzeriaNicsiDen/?locale=ro_RO" target="_blank">
                            📘 Facebook
                        </a>
                    </li>

                    <!-- Link Admin (vizibil doar pentru Owner) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-sm btn-outline-warning fw-bold px-3 py-1" asp-area="" asp-controller="Admin" asp-action="Index">⚙️ Panou Admin</a>
                        </li>
                    }
                </ul>
                
                <!-- Secțiunea Autentificare (Dreapta) -->
                <ul class="navbar-nav align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center">
                            <span class="me-3" style="color: var(--text-main);">Salut, @User.Identity.Name!</span>
                            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Account" asp-action="Logout" style="color: white; border-color: #3d3d3d;">Deconectare</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-accent btn-sm fw-bold px-3 py-2" asp-area="" asp-controller="Account" asp-action="Login">Conectare cu Google</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

  <footer class="border-top footer text-muted mt-5" style="border-color: var(--accent-gold) !important; color: var(--text-main) !important;">
    <div class="container text-center py-3">
        &copy; Pizzeria Nic&Den - Comenzi: <a href="tel:0759108991" style="color: var(--accent-gold); text-decoration: none;">0759 108 991</a>
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
